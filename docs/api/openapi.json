urer and course must exist. Due date must be today or in the future.","operationId":"create_assignment_api_assignments_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateAssignmentRequest"}}},"required":true},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignmentResponse"}}}},"404":{"description":"Lecturer or course not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Course is inactive","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"422":{"description":"Validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/assignments/overdue":{"get":{"tags":["Assignments"],"summary":"List overdue assignments","description":"Return all published assignments whose due date has passed.","operationId":"list_overdue_api_assignments_overdue_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"items":{"$ref":"#/components/schemas/AssignmentResponse"},"type":"array","title":"Response List Overdue Api Assignments Overdue Get"}}}}}}},"/api/assignments/course/{course_id}":{"get":{"tags":["Assignments"],"summary":"List assignments for a course","description":"Return all assignments belonging to a given course.","operationId":"list_by_course_api_assignments_course__course_id__get","parameters":[{"name":"course_id","in":"path","required":true,"schema":{"type":"string","title":"Course Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AssignmentResponse"},"title":"Response List By Course Api Assignments Course  Course Id  Get"}}}},"404":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Not Fou